# PG Atlas Backend — environment variable template.
# Copy this file to .env and fill in values for local development.
# Never commit .env to version control.
#
# All variables are prefixed with PG_ATLAS_.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Canonical URL of this API instance. Used as the OIDC audience when verifying
# GitHub OIDC tokens submitted by the pg-atlas-sbom-action.
# For local development use http://localhost:8000; for production use the public URL.
PG_ATLAS_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Required for database write path
# ---------------------------------------------------------------------------

# Async SQLAlchemy connection URL (asyncpg driver).
# Note the local dev superuser is 'atlas' (postgres:18 disallows 'pg_'-prefixed names).
# For docker-compose local dev:
#   - the Postgres container hostname is `postgres` (not localhost)
#   - change `changeme` to match PG_ATLAS_POSTGRES_PASSWORD.
PG_ATLAS_DATABASE_URL=postgresql://atlas:changeme@localhost:5432/pg_atlas

# Filesystem path where raw SBOM bytes are written (local dev / host side).
# The docker-compose api container mounts ./artifact_store to /data/artifacts;
# inside the container set this to /data/artifacts.
PG_ATLAS_ARTIFACT_STORE_PATH=./artifact_store

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# OpenGrants API key for increased rate limits
# PG_ATLAS_OPENGRANTS_KEY=a0929b...8d3775

# Python logging level: DEBUG | INFO | WARNING | ERROR  (default: INFO)
# PG_ATLAS_LOG_LEVEL=INFO

# Seconds to cache GitHub's JWKS response (default: 3600)
# PG_ATLAS_JWKS_CACHE_TTL_SECONDS=3600

# Read artifacts from IPFS instead of the local filesystem
# PG_ATLAS_IPFS_GATEWAY_URL=https://ipfs.filebase.io/ipfs

# --- GitHub dependents crawler (collection/audit only; writes no graph edges) ---
# Scheduling fails closed: both settings are required to schedule crawls.
# Allowlist is comma-separated owner/repo (case-insensitive); "*" = all repos.
# Changing these does not cancel already-queued jobs. CLI runs bypass both:
#   uv run python -m pg_atlas.crawlers github Soneso/stellar_flutter_sdk
# PG_ATLAS_GITHUB_DEPENDENTS_ENABLED=false
# PG_ATLAS_GITHUB_DEPENDENTS_ALLOWLIST=Soneso/stellar_flutter_sdk,Soneso/stellar-php-sdk
# Caps per repository: pages per listing, unique dependents overall, packages walked.
# PG_ATLAS_GITHUB_DEPENDENTS_PAGES_CAP=20
# PG_ATLAS_GITHUB_DEPENDENTS_ENTRY_CAP=500
# PG_ATLAS_GITHUB_DEPENDENTS_PACKAGES_CAP=25

# --- Maintenance metric (signal collection and per-repo profiles) ---
# Scheduling fails closed: ENABLED=true schedules only allowlisted repos
# (comma-separated owner/repo, case-insensitive; "*" = all); declared host
# repos are never scheduled, even when allowlisted. The collector re-checks
# both settings at execution time; gated materialization re-checks ENABLED.
# CLI runs bypass the gate:
#   uv run python -m pg_atlas.procrastinate.github_maintenance Soneso/stellar-php-sdk
#   uv run python -m pg_atlas.metrics.materialize_maintenance --export profiles.json
# PG_ATLAS_MAINTENANCE_METRIC_ENABLED=false
# PG_ATLAS_MAINTENANCE_METRIC_ALLOWLIST=Soneso/stellar_flutter_sdk,Soneso/stellar-php-sdk
# Declared repo lists (comma-separated owner/repo): issue tracking outside
# GitHub; host repos (hold a funded project's contributions but are not
# controlled or maintained by it as a whole); repos that deploy from the
# default branch and use Releases as a changelog.
# PG_ATLAS_MAINTENANCE_EXTERNAL_TRACKER_REPOS=
# PG_ATLAS_MAINTENANCE_HOST_REPOS=LedgerHQ/app-stellar,trezor/trezor-firmware
# PG_ATLAS_MAINTENANCE_DEPLOY_ON_PUSH_REPOS=
# Declared maintainer logins per repo, comma-separated owner/repo=login1|login2.
# PG_ATLAS_MAINTENANCE_DECLARED_MAINTAINERS=stellar/js-stellar-sdk=login1|login2
# Measurement parameters: trailing window and first-response interval (days),
# cadence over the last N shipping events with a minimum count, cohort
# membership of prereleases and draft PRs.
# PG_ATLAS_MAINTENANCE_WINDOW_DAYS=90
# PG_ATLAS_MAINTENANCE_RESPONSE_INTERVAL_DAYS=7
# PG_ATLAS_MAINTENANCE_CADENCE_LAST_N_EVENTS=10
# PG_ATLAS_MAINTENANCE_CADENCE_MIN_EVENTS=3
# PG_ATLAS_MAINTENANCE_INCLUDE_PRERELEASES=true
# PG_ATLAS_MAINTENANCE_INCLUDE_DRAFT_PRS=true
# Per-repo collection caps: listing pages per item type, API requests,
# wall-clock seconds; longest single wait for a rate-limit reset.
# PG_ATLAS_MAINTENANCE_ITEM_PAGE_CAP=10
# PG_ATLAS_MAINTENANCE_REQUEST_CAP=120
# PG_ATLAS_MAINTENANCE_TIME_CAP_SECONDS=180
# PG_ATLAS_MAINTENANCE_RATE_LIMIT_MAX_WAIT_SECONDS=120
# Freshness bounds (days): older collected signals and git-log artifacts are
# context only, never ranked.
# PG_ATLAS_MAINTENANCE_SIGNALS_MAX_AGE_DAYS=14
# PG_ATLAS_MAINTENANCE_GITLOG_MAX_AGE_DAYS=21

# ---------------------------------------------------------------------------
# docker-compose helpers (consumed by docker-compose.yml, not by the app)
# ---------------------------------------------------------------------------

# PostgreSQL password for the atlas user on the local postgres:18 container.
# Must match the password in PG_ATLAS_DATABASE_URL above.
PG_ATLAS_POSTGRES_PASSWORD=changeme
